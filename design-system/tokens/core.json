{
  "name": "Neo Brutalism UI",
  "version": "1.0.0",
  "description": "Source-of-truth tokens for a Neo-Brutalist interface with optional retro accents.",
  "color": {
    "ink": "#111111",
    "paper": "#FFF9ED",
    "paperMuted": "#F4EAD6",
    "white": "#FFFFFF",
    "yellow": "#FFD84D",
    "pink": "#FF6B9D",
    "blue": "#67D5FF",
    "green": "#95E06C",
    "orange": "#FF8A3D",
    "red": "#FF5C5C",
    "lineMuted": "#6E665A"
  },
  "font": {
    "display": "Space Grotesk, Arial Black, Arial, sans-serif",
    "body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "pixel": "monospace"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "pill": "999px"
  },
  "border": {
    "thin": "2px",
    "strong": "3px",
    "heavy": "4px"
  },
  "shadow": {
    "sm": "4px 4px 0 #111111",
    "md": "8px 8px 0 #111111",
    "lg": "12px 12px 0 #111111",
    "pressed": "2px 2px 0 #111111"
  },
  "motion": {
    "fast": "120ms ease",
    "standard": "180ms ease",
    "reduced": "0ms"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1080px"
  }
}
